{
    // IntelliSense 配置：与 tools 下批处理的 MSVC Debug x64 编译选项保持一致
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/Core",
                "${workspaceFolder}/UnityPlugin",
                "${workspaceFolder}/EditorPlugin",
                "${workspaceFolder}/Main",
                "${workspaceFolder}/Tests"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ]
}
